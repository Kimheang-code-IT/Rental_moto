# HollyWing Motor — production environment template
# Copy to `.env` on the production host and replace EVERY placeholder.
# Never commit a real `.env` file.

# --- Database ---
POSTGRES_USER=rental
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=rental_moto

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_JWT_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Telegram ---
# Optional override. Prefer System Settings → Telegram → Bot token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_MODE=polling
TELEGRAM_BOT_CLIENT_ID=rental-telegram-bot
TELEGRAM_BOT_CLIENT_SECRET=CHANGE_ME_LONG_RANDOM_TELEGRAM_CLIENT_SECRET

# --- First admin ---
# Do not set SEED_ADMIN_* variables; they are not used. Register the first
# administrator at /auth/setup (email + password) while the users table is empty.

# --- Images (built locally, no registry login) ---
# Every image is built from source on this host. Leave IMAGE_TAG empty unless
# you want to label builds, e.g. IMAGE_TAG=sha-abc1234 or IMAGE_TAG=v1.0.0.
IMAGE_TAG=local

DEBUG=false

# --- Small-host resource profile (< 5 users, ~2 GB host) ---
# Container limits applied by docker-compose.prod.yml. Lower them if the host
# is smaller; raise them if the host has more RAM.
DB_MEMORY=512M
DB_CPUS=1.0
REDIS_MEMORY=192M
REDIS_CPUS=0.5
API_MEMORY=640M
API_CPUS=1.0
WORKER_MEMORY=384M
WORKER_CPUS=0.5
CELERY_CONCURRENCY=1
CELERY_MAX_TASKS_PER_CHILD=50
# Set to 0 to stop the Telegram notification worker and save RAM. The API still
# works; outbound Telegram notifications are queued but not delivered.
TELEGRAM_WORKER_REPLICAS=1
BOT_MEMORY=192M
BOT_CPUS=0.25
FRONTEND_MEMORY=128M
FRONTEND_CPUS=0.25

# --- Public URLs ---
# Exact browser origins allowed to call the API (comma-separated, no trailing slash).
CORS_ORIGINS=https://app.your-domain.com
CORS_ALLOW_PRIVATE_NETWORKS=false
FRONTEND_PORT=80
ENVIRONMENT=production

# Frontend build-time public site URL (Open Graph / share previews).
NUXT_PUBLIC_SITE_URL=https://app.your-domain.com
NUXT_PUBLIC_API_BASE=same-origin
NUXT_PUBLIC_AUTH_MODE=bearer
NUXT_PUBLIC_USE_MOCK_DATA=false
NUXT_PUBLIC_APP_VERSION=1.0.0

# --- Redis / Celery (set automatically in compose; override only if needed) ---
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/3
# CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Local filesystem exports (mounted at /srv/data in Docker) ---
EXPORT_DIR=/srv/data/exports
