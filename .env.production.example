# HollyWing Motor — production environment template
# Copy to `.env` on the production host and replace EVERY placeholder.
# Never commit a real `.env` file.

# --- Database ---
POSTGRES_USER=rental
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=rental_moto

# --- RabbitMQ ---
RABBITMQ_USER=rental
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_RABBITMQ_PASSWORD
RABBITMQ_VHOST=rental

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_JWT_SECRET

# --- Telegram ---
TELEGRAM_BOT_TOKEN=CHANGE_ME_BOTFATHER_TOKEN
TELEGRAM_BOT_MODE=polling
TELEGRAM_BOT_CLIENT_ID=rental-telegram-bot
TELEGRAM_BOT_CLIENT_SECRET=CHANGE_ME_LONG_RANDOM_TELEGRAM_CLIENT_SECRET

# --- First admin (created only when missing) ---
SEED_ADMIN_EMAIL=admin@your-company.com
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
SEED_ADMIN_NAME=System Administrator

# --- GitHub Container Registry (pre-built images) ---
# Images are published by .github/workflows/publish-images.yml
IMAGE_REGISTRY=ghcr.io/kimheang-code-it/rental_moto
IMAGE_TAG=latest
PULL_POLICY=always

DEBUG=false

# --- Public URLs ---
# Exact browser origins allowed to call the API (comma-separated, no trailing slash).
CORS_ORIGINS=https://app.your-domain.com
CORS_ALLOW_PRIVATE_NETWORKS=false
FRONTEND_PORT=80
ENVIRONMENT=production

# Frontend build-time public site URL (Open Graph / share previews).
NUXT_PUBLIC_SITE_URL=https://app.your-domain.com
NUXT_PUBLIC_API_BASE=same-origin
NUXT_PUBLIC_AUTH_MODE=bearer
NUXT_PUBLIC_USE_MOCK_DATA=false
NUXT_PUBLIC_APP_VERSION=1.0.0

# --- MinIO (private invoice storage) ---
MINIO_ENABLED=true
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD
MINIO_BUCKET=rental-files
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_USER
MINIO_SECRET_KEY=CHANGE_ME_STRONG_MINIO_PASSWORD
MINIO_SECURE=false
