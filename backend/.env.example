POSTGRES_USER=rental
POSTGRES_PASSWORD=rental
POSTGRES_DB=rental_moto

JWT_SECRET_KEY=dev-only-secret-change-me-in-production-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_MODE=polling
TELEGRAM_BOT_CLIENT_ID=rental-telegram-bot
TELEGRAM_BOT_CLIENT_SECRET=dev-only-telegram-secret-change-me-0123456789abcdef

# No SEED_ADMIN_* variables: the first administrator is registered through the
# public /auth/setup page while the users table is empty.

CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80

# In development, also allow browser origins on private LAN IPs (192.168.x.x, 10.x.x.x, etc.).
CORS_ALLOW_PRIVATE_NETWORKS=true

# Host port for the nginx frontend container (use 3000 if port 80 is unavailable).
FRONTEND_PORT=80

# Optional: pin images when using GHCR instead of a local build.
# IMAGE_REGISTRY=ghcr.io/kimheang-code-it/rental_moto
# IMAGE_TAG=local

# Redis (Docker network): /0 cache, /1 telegram-bot, /2 celery results, /3 celery broker
# CELERY_BROKER_URL=redis://redis:6379/3
# CELERY_RESULT_BACKEND=redis://redis:6379/2

# Export files (CSV/XLSX). Invoice browser print stays in the frontend.
# EXPORT_DIR=./data/exports

# Development-only credentials. Change every value before any real deployment.
# For production, copy `.env.production.example` to `.env` and follow
# `docs/PRODUCTION_CHECKLIST.md`.
